ALLOWED_AUTH = {"FULL", "EXPERT_ONLY", "NO_PUBLICATION"}
ALLOWED_EVIDENCE = {"L1", "L2", "L3", "L4"}
ALLOWED_STATES = {"available", "partial", "missing", "not_applicable", "not_exposed", "insufficient_coverage"}
ALLOWED_PAGE_CLASSES = {
    "cover", "how_to_read", "executive_portrait", "profile_module",
    "cross_layer", "limitations", "technical_appendix",
}
SANITIZED_ID_RE = re.compile(r"^[A-Z0-9][A-Z0-9._:-]{2,63}$")
INTERNAL_ID_RE = re.compile(r"\b(?:CLM|SYN|BLK|BR|JOB|RHO|RLD|RPK)-[A-Za-z0-9._:-]+\b")
EMAIL_RE = re.compile(r"\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b", re.I)
PHONE_RE = re.compile(r"(?<!\d)(?:\+?\d[\s().-]*){9,}(?!\d)")

GRAPHITE = "#202526"
MUTED = "#5D6869"
TEAL = "#3F7475"
TEAL_LIGHT = "#EAF1F0"
STONE = "#D8D4CD"
STONE_LIGHT = "#F3F1ED"


class ReferenceRenderError(Exception):
    pass


def canonical_json_bytes(value: Any) -> bytes:
    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def _require(cond: bool, message: str) -> None:
    if not cond:
        raise ReferenceRenderError(message)


def _assert_no_sensitive_visible_text(text: str, where: str) -> None:
    _require(not EMAIL_RE.search(text), f"visible email-like content forbidden at {where}")
    _require(not PHONE_RE.search(text), f"visible phone-like content forbidden at {where}")
    _require(not INTERNAL_ID_RE.search(text), f"visible internal routing identifier forbidden at {where}")


def validate_print_document(doc: Mapping[str, Any]) -> Dict[str, Any]:
    _require(doc.get("schema_id") == PRINT_SCHEMA_ID, "unexpected print schema_id")
    _require(doc.get("schema_version") == PRINT_SCHEMA_VERSION, "unexpected print schema_version")
    _require(doc.get("architecture_id") == ARCHITECTURE_ID, "unexpected architecture_id")
    auth = doc.get("publication_authorization")
    _require(auth in ALLOWED_AUTH, "unknown publication_authorization")
    _require(auth != "NO_PUBLICATION", "NO_PUBLICATION cannot be rendered")
    language = doc.get("language")
    _require(language in {"ru", "en"}, "unsupported language")
    report_id = doc.get("report_id")
    _require(isinstance(report_id, str) and SANITIZED_ID_RE.fullmatch(report_id), "report_id must be sanitized")
    title = doc.get("title")
    _require(isinstance(title, str) and 2 <= len(title) <= 180, "invalid title")
    _assert_no_sensitive_visible_text(title, "title")

    pages = doc.get("pages")
    _require(isinstance(pages, list) and pages, "pages must be a non-empty array")
    _require(pages[0].get("page_class") == "cover", "first page class must be cover")
    present = {p.get("page_class") for p in pages}
    missing_classes = ALLOWED_PAGE_CLASSES - present
    _require(not missing_classes, f"reference document missing page classes: {sorted(missing_classes)}")

    seen_elements: set[str] = set()
    trace_rows = []
    for pi, page in enumerate(pages):
        pclass = page.get("page_class")
        _require(pclass in ALLOWED_PAGE_CLASSES, f"unknown page_class at {pi}: {pclass}")
        for field in ("heading", "intro", "subtitle", "note", "kicker"):
            value = page.get(field)
            if value is not None:
                _require(isinstance(value, str), f"page {field} must be string at {pi}")
                _assert_no_sensitive_visible_text(value, f"pages[{pi}].{field}")
        fields = page.get("fields", [])
        _require(isinstance(fields, list), f"fields must be array at page {pi}")
        for fi, row in enumerate(fields):
            _require(isinstance(row, list) and len(row) == 2, f"invalid technical field at {pi}/{fi}")
            for ci, value in enumerate(row):
                _require(isinstance(value, str), f"technical field value must be string at {pi}/{fi}/{ci}")
                _assert_no_sensitive_visible_text(value, f"pages[{pi}].fields[{fi}][{ci}]")

        blocks = page.get("blocks", [])
        _require(isinstance(blocks, list), f"blocks must be array at page {pi}")
        for bi, block in enumerate(blocks):
            eid = block.get("element_id")
            _require(isinstance(eid, str) and SANITIZED_ID_RE.fullmatch(eid), f"invalid element_id at {pi}/{bi}")
            _require(eid not in seen_elements, f"duplicate element_id: {eid}")
            seen_elements.add(eid)
            evidence = block.get("evidence_class")
            _require(evidence in ALLOWED_EVIDENCE or evidence is None, f"invalid evidence_class at {eid}")
            state = block.get("source_state", "available")
            _require(state in ALLOWED_STATES, f"invalid source_state at {eid}")
            if evidence in {"L1", "L2"}:
                _require("source_state" in block, f"{evidence} requires explicit source_state at {eid}")
            if evidence in {"L3", "L4"}:
                _require(block.get("numeric_value") is None, f"{evidence} cannot carry numeric_value at {eid}")
            if state in {"missing", "not_applicable", "not_exposed", "insufficient_coverage"}:
                _require(block.get("numeric_value") is None, f"missing-like state cannot carry numeric_value at {eid}")
            if block.get("numeric_value") is not None:
                _require(isinstance(block.get("numeric_value"), (int, float)) and not isinstance(block.get("numeric_value"), bool), f"numeric_value must be numeric at {eid}")
            for key in ("title", "text", "visible_state", "unit"):
                val = block.get(key)
                if val is not None:
                    _require(isinstance(val, str), f"{key} must be string at {eid}")
                    _assert_no_sensitive_visible_text(val, f"pages[{pi}].blocks[{bi}].{{key}}")
            source_ids = block.get("source_ids", [])
            _require(isinstance(source_ids, list), f"source_ids must be array at {eid}")
            for sid in source_ids:
                _require(isinstance(sid, str) and 2 <= len(sid) <= 96, f"invalid source_id at {eid}")
                trace_rows.append({"element_id": eid, "source_id": sid, "evidence_class": evidence, "source_state": state})
    return {"valid": True, "page_count": len(pages), "trace_rows": trace_rows}


def verify_font_binaries(font_dir: Path) -> Dict[str, str]:
    _require(font_dir.is_dir(), "font directory missing")
    out = {}
    for name, expected in FONT_PINS.items():
        p=font_dir/name
        _require(p.is_file(), f"canonical font missing: {name}")
        observed = sha256_file(p)
        _require(observed == expected, f"font sha256 mismatch: {name}")
        out[name] = observed
    return out


def _e(value: Any) -> str:
    return html.escape(str(value), quote=True)

