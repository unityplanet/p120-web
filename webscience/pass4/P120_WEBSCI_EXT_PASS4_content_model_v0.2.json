  "evidence_state_ladder": [
    {
      "level": "E0",
      "state": "EXTERNAL_SCIENTIFIC_FOUNDATION",
      "meaning": "Published literature, empirical findings, established constructs, theoretical models and measurement precedents relevant to the measurement territory.",
      "does_not_mean": "Validation of the integrated P-120 architecture."
    },
    {
      "level": "E1",
      "state": "INTERNAL_ARCHITECTURE_VERIFICATION",
      "meaning": "P-120 construct-boundary, redundancy, ownership, item-level, information-gain, scope/exposure, safety/privacy, computational-contract and cross-module verification work.",
      "does_not_mean": "Reliability, factor validity, norms or population generalizability."
    },
    {
      "level": "E2",
      "state": "HUMAN_COGNITIVE_OR_CROSSCHECK_EVIDENCE",
      "meaning": "Evidence-bearing human comprehension/discrimination/field observations or controlled cross-check observations used to adjudicate development hypotheses.",
      "does_not_mean": "Completed psychometric validation or external replication."
    },
    {
      "level": "E3",
      "state": "PSYCHOMETRIC_VALIDATION",
      "meaning": "Quantitative respondent-sample evidence addressing reliability, factor structure, discriminant/incremental validity, stability, invariance or other explicitly tested psychometric properties.",
      "does_not_mean": "Independent external replication unless separately established."
    },
    {
      "level": "E4",
      "state": "EXTERNAL_REPLICATION",
      "meaning": "Independent or externally reproduced evidence under a separately defined replication authority.",
      "does_not_mean": "A default state of any current module."
    }
  ],
